--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogueLoc_ko
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 642070058e751ba448ff8e623a79c71b, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 57487491264512
    m_Localized: "\uC548\uB155\uD558\uC138\uC694. \"STYXYZ\" \uC6B4\uC1A1 \uD68C\uC0AC\uC5D0\uC11C
      \uC77C\uD558\uAE30\uB85C \uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 57487591927808
    m_Localized: O.A.R.
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122112
    m_Localized: "\uC624\uB298\uC774 \uCCAB \uCD9C\uADFC\uC774\uC2DC\uAD70\uC694!
      \uC800\uB294 AI \uC5B4\uC2DC\uC2A4\uD134\uD2B8 O.A.R.\uC608\uC694. \uC5C5\uBB34\uB97C
      \uCD5C\uB300\uD55C \uC798 \uD574\uB0B4\uC2E4 \uC218 \uC788\uB3C4\uB85D \uB3C4\uC640\uB4DC\uB9B4\uAC8C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122113
    m_Localized: "\uC544\uC2DC\uB2E4\uC2DC\uD53C \"STYXYZ\"\uB294 \uC2B9\uAC1D\uC744
      \uBAA9\uC801\uC9C0\uAE4C\uC9C0 \uC548\uC804\uD558\uAC8C \uBAA8\uC2DC\uB294
      \uAC83\uBFD0\uB9CC \uC544\uB2C8\uB77C..."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122114
    m_Localized: "\uC2B9\uAC1D\uC774 \uCD5C\uB300\uD55C \uD3B8\uC548\uD558\uAC8C
      \uC774\uB3D9\uD560 \uC218 \uC788\uB3C4\uB85D \uD558\uB294 \uAC83\uB3C4 \uC911\uC694\uD558\uAC8C
      \uC0DD\uAC01\uD558\uC8E0!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122115
    m_Localized: "\uADF8\uB7EC\uB824\uBA74 \uC2B9\uAC1D\uC758 \uAE30\uBD84\uC5D0
      \uB9DE\uB294 \uBD84\uC704\uAE30\uB97C \uB9CC\uB4E4\uC5B4\uC57C \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122116
    m_Localized: "\uC544, \uCCAB \uC190\uB2D8\uC774 \uACE7 \uB3C4\uCC29\uD560 \uAC83
      \uAC19\uB124\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122117
    m_Localized: "\uC790\uC5F0\uC2A4\uB7FD\uAC8C \uD589\uB3D9\uD558\uC2DC\uACE0,
      \uC190\uB2D8\uC758 \uC774\uC57C\uAE30\uB97C \uC798 \uB4E4\uC73C\uBA74\uC11C
      \uC5B4\uB5A4 \uAE30\uBD84\uC778\uC9C0 \uD30C\uC545\uD574 \uBCF4\uC138\uC694.
      \uD589\uC6B4\uC744 \uBE4C\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122118
    m_Localized: "\uC548\uB155\uD558\uC138\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122119
    m_Localized: Vanessa
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122120
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122121
    m_Localized: "\uB450 \uBD84 \uB300\uD654\uAC00 \uAF64 \uC9C4\uC9C0\uD558\uB124\uC694...
      \uBB50, \uBB3C\uB860 \uC544\uC9C1 \uC6B0\uB9AC \uC0AC\uB791\uC2A4\uB7EC\uC6B4
      \uC190\uB2D8\uC744 \uC704\uD55C \uBD84\uC704\uAE30\uB97C \uB9CC\uB4E4\uC9C0
      \uC54A\uC73C\uC168\uC73C\uB2C8\uAE4C\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122122
    m_Localized: "\uADF8\uB7EC\uB824\uBA74 \uBA87 \uAC00\uC9C0\uB97C \uD574\uC57C
      \uD574\uC694.\n\uBA3C\uC800 \uB77C\uB514\uC624\uB97C \uCF1C \uBCFC\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122123
    m_Localized: "\uB77C\uB514\uC624\uB97C \uCF1C\uB824\uBA74 \uADF8\uCABD\uC744
      \uCDA9\uBD84\uD788 \uBE64\uD788 \uBC14\uB77C\uBCF4\uAE30\uB9CC \uD558\uBA74
      \uB3FC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122124
    m_Localized: "\uADF8\uB2E4\uC74C\uC5D4 \uD3B8\uC548\uD55C \uC74C\uC545\uC744
      \uCC3E\uC544\uBCF4\uC138\uC694. \uC190\uB2D8\uC774 \uBB54\uAC00 \uD798\uB4E0
      \uC77C\uC744 \uACAA\uACE0 \uC788\uB294 \uAC83 \uAC19\uAC70\uB4E0\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122125
    m_Localized: "\uBC29\uC1A1\uC744 \uBC14\uAFB8\uB824\uBA74 \uB2E4\uC774\uC5BC\uC744
      \uB3CC\uB9AC\uAE30\uB9CC \uD558\uBA74 \uB3FC\uC694!\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122126
    m_Localized: "\uC88B\uC544\uC694! \uC774 \uC815\uB3C4\uBA74 \uAD1C\uCC2E\uACA0\uC5B4\uC694.\n\uC790,
      \uC774\uC81C \uB2E4\uC74C\uC73C\uB85C \uC54C\uB9DE\uC740 \uC870\uBA85\uC744
      \uC124\uC815\uD574\uC57C \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122127
    m_Localized: "\uCC28\uB7C9 \uC870\uBA85 \uC870\uC808\uAE30\uB294 \uB8F8\uBBF8\uB7EC
      \uADFC\uCC98 \uCC9C\uC7A5 \uCABD\uC5D0 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122128
    m_Localized: "\uC870\uBA85\uC744 \uD30C\uB780\uC0C9\uC73C\uB85C \uBC14\uAFB8\uB824\uBA74
      \uD30C\uB780\uC0C9 \uBC84\uD2BC\uC744 \uC5EC\uB7EC \uBC88 \uB204\uB974\uAE30\uB9CC
      \uD558\uBA74 \uB3FC\uC694. \uC815\uB9D0 \uAC04\uB2E8\uD558\uC8E0!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122129
    m_Localized: "\uC800\uB294 \uD30C\uB780\uC0C9\uC744 \uC815\uB9D0 \uC88B\uC544\uD558\uB294\uB370,
      \uC190\uB2D8\uB3C4 \uBD84\uBA85 \uC88B\uC544\uD558\uC2E4 \uAC83 \uAC19\uC544\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122130
    m_Localized: "\uC0C9\uC744 \uC870\uD569\uD560 \uC218\uB3C4 \uC788\uC9C0\uB9CC,
      \uC77C\uB2E8\uC740 \uAC04\uB2E8\uD55C \uAC83\uBD80\uD130 \uD574 \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122131
    m_Localized: "\uD6CC\uB96D\uD574\uC694! \uC815\uB9D0 \uD0C0\uACE0\uB098\uC168\uB124\uC694!\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122132
    m_Localized: "\uC9C0\uAE08 \uB9CC\uB4E4\uACE0 \uC788\uB294 \uBD84\uC704\uAE30\uAC00
      \uC190\uB2D8\uC5D0\uAC8C \uC798 \uB9DE\uB294\uC9C0 \uD655\uC778\uD558\uB824\uBA74
      \uC5B8\uC81C\uB4E0 SYNCHRONIZER\uB97C \uC774\uC6A9\uD558\uBA74 \uB3FC\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122133
    m_Localized: "SYNCHRONIZER\uB97C \uBCF4\uBA74 \uC190\uB2D8\uC774 \uC5BC\uB9C8\uB098
      \uB9C8\uC74C\uC744 \uC5F4\uACE0 \uC788\uB294\uC9C0 \uC54C \uC218 \uC788\uC5B4\uC694.\n\uCC98\uC74C\uC5D4
      \uC5B4\uB824\uC6B8 \uC218\uB3C4 \uC788\uC9C0\uB9CC, \uBD84\uBA85 \uC798\uD558\uC2E4
      \uC218 \uC788\uC744 \uAC70\uC608\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122134
    m_Localized: "\uC190\uB2D8\uC774 \uC790\uC2E0\uC5D0 \uAD00\uD55C \uC774\uC57C\uAE30\uB97C
      \uB9CE\uC774 \uD138\uC5B4\uB193\uC744\uC218\uB85D \uAE30\uC0AC\uB2D8\uC5D0
      \uB300\uD55C \uB9AC\uBDF0\uB3C4 \uC88B\uC544\uC9C8 \uAC70\uC608\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122135
    m_Localized: "\uADF8\uB9AC\uACE0 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD55C \uAC00\uC9C0\uB9CC
      \uB354\uC694. \uCC98\uC74C \uB5A0\uC624\uB978 \uBD84\uC704\uAE30\uAC00 \uD56D\uC0C1
      \uAC00\uC7A5 \uC88B\uC740 \uAC74 \uC544\uB2C8\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122136
    m_Localized: "\uC5B4\uB5A4 \uC758\uBBF8\uC5D0\uC11C\uB294 \uC2EC\uB9AC \uC0C1\uB2F4\uC0AC\uAC00
      \uB41C \uAC83\uCC98\uB7FC \uC0DD\uAC01\uD574 \uBCF4\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122137
    m_Localized: "\uD558\uC9C0\uB9CC \uB108\uBB34 \uC790\uC8FC \uBC14\uAFB8\uBA74
      \uC190\uB2D8\uC774 \uBD80\uB2F4\uC2A4\uB7EC\uC6CC\uC838\uC11C \uB300\uD654\uB97C
      \uC774\uC5B4 \uAC00\uACE0 \uC2F6\uC9C0 \uC54A\uC744 \uC218\uB3C4 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122138
    m_Localized: "\uC190\uB2D8\uC774 \uACE7 \uB9C8\uC74C\uC744 \uC5F4 \uAC83 \uAC19\uC544\uC694!\n\uC790,
      \uD589\uC6B4\uC744 \uBE4C\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122139
    m_Localized: "\uC5B4\uB5A4 \uC190\uB2D8\uC740 \uD2B9\uC815\uD55C \uAC10\uC815\uC744
      \uB04C\uC5B4\uB0B4\uC57C\uB9CC \uB9C8\uC74C\uC744 \uC5F4\uAE30\uB3C4 \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122140
    m_Localized: "\uC774 \uC77C, \uB9C8\uC74C\uC5D0 \uB4DC\uC138\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122141
    m_Localized: "\uC8C4\uC1A1\uD574\uC694, \uB9D0\uC774 \uC880 \uC774\uC0C1\uD558\uAC8C
      \uB098\uC654\uB124\uC694. \uADF8\uB0E5 \uB9E4\uC77C ///\uBAA8\uB974\uB294 \uC0AC\uB78C\uB4E4///\uC774
      \uCC28\uC5D0 \uD0C0\uB294\uB370\uB3C4 \uC5B4\uB5BB\uAC8C \uC544\uBB34\uB807\uC9C0
      \uC54A\uC744 \uC218 \uC788\uB294\uC9C0 \uC774\uD574\uAC00 \uC548 \uB3FC\uC11C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122142
    m_Localized: "\uC220\uC5D0 \uCDE8\uD574 \uD589\uD328\uB97C \uBD80\uB9AC\uB294
      \uC0AC\uB78C\uB4E4 \uB4A4\uCC98\uB9AC\uB3C4 \uD574\uC57C \uD558\uACE0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122143
    m_Localized: "\uB0AF\uC120 \uC0AC\uB78C\uB4E4\uACFC \uB300\uD654\uD558\uBA74\uC11C,
      \uB098\uC05C \uB9AC\uBDF0\uB97C \uB0A8\uAE30\uC9C0 \uC54A\uB3C4\uB85D \uBB34\uB840\uD558\uAC8C
      \uAD74\uC9C0 \uC54A\uC73C\uB824\uACE0 \uC2E0\uACBD\uB3C4 \uC368\uC57C \uD558\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122144
    m_Localized: "\uD558\uB8E8\uC5D0 \uADF8\uB807\uAC8C \uB9CE\uC740 \uC7A1\uB2F4\uC744
      \uB098\uB204\uB294 \uAC74 ///\uC808\uB300 \uBABB \uD560 \uAC83 \uAC19\uC544\uC694///."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122145
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122146
    m_Localized: "\uC798\uD588\uC5B4\uC694! SYNCHRONIZER\uAC00 \uC5B4\uB5BB\uAC8C
      \uC791\uB3D9\uD558\uB294\uC9C0 \uC774\uD574\uD558\uC168\uAE38 \uBC14\uB77C\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122149
    m_Localized: "\uC790, \uC774\uC81C \uC77C\uD560 \uC2DC\uAC04\uC774\uC5D0\uC694!\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122150
    m_Localized: "\uC798\uD588\uC5B4\uC694! SYNCHRONIZER\uAC00 \uC5B4\uB5BB\uAC8C
      \uC791\uB3D9\uD558\uB294\uC9C0 \uC774\uD574\uD558\uC168\uAE38 \uBC14\uB77C\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122153
    m_Localized: "\uC790, \uC774\uC81C \uC77C\uD560 \uC2DC\uAC04\uC774\uC5D0\uC694!\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122154
    m_Localized: "\uC0AC\uC2E4... \uADF8 \uC0AC\uB78C\uB4E4\uD55C\uD14C \uADF8\uB7F0
      \uB9D0\uC744 \uD558\uB294 \uAC74 \uACF5\uD3C9\uD558\uC9C0 \uC54A\uC744\uC9C0\uB3C4
      \uBAA8\uB974\uACA0\uB124\uC694.\n\uADF8 \uC0AC\uB78C\uB4E4\uBCF4\uB2E4\uB294
      \uC81C \uCABD\uC5D0 \uB354 \uD070 \uBB38\uC81C\uC778 \uAC83 \uAC19\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122155
    m_Localized: "\uB204\uAD70\uAC00 \uC800\uD55C\uD14C \uB9D0\uC744 \uAC78 \uB54C\uB9C8\uB2E4
      \uC800\uB294 \uBC8C\uC368 \uC81C \uC790\uC2E0\uC744 \uD3C9\uAC00\uD558\uACE0
      \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122156
    m_Localized: "\uC81C\uAC00 \uBB34\uC2A8 \uB9D0\uC744 \uD588\uB294\uC9C0. \uC5B4\uB5BB\uAC8C
      \uB9D0\uD588\uB294\uC9C0. \uD45C\uC815\uC774 \uC774\uC0C1\uD558\uC9C4 \uC54A\uC558\uB294\uC9C0."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122157
    m_Localized: "\uB300\uD654\uAC00 \uB05D\uB0A0 \uB54C\uCBE4\uC774\uBA74 \uC81C
      \uC790\uC2E0\uC5D0\uAC8C 10\uC810 \uB9CC\uC810\uC5D0 2\uC810 \uC815\uB3C4\uB97C
      \uC918\uC694. \uB9E4\uBC88\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122158
    m_Localized: "\uADF8\uB798\uC11C \uADF8\uB0E5 \uB9D0\uC744 ///\uAD73\uC774 \uD558\uC9C0
      \uC54A\uC544\uC694///. \uB098\uC05C \uB9AC\uBDF0\uB97C \uBC1B\uB294 \uAC83\uBCF4\uB2E4\uB294
      \uB9AC\uBDF0\uAC00 \uC5C6\uB294 \uAC8C \uB0AB\uC796\uC544\uC694, \uADF8\uB807\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122159
    m_Localized: "\uC81C\uAC00 \uBA3C\uC800 \uC774\uB807\uAC8C \uB9D0\uC744 \uAEBC\uB0C8\uB2E4\uB294
      \uAC8C \uC194\uC9C1\uD788 \uC800\uB3C4 \uB180\uB77C\uC6CC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122160
    m_Localized: "\uD55C... \uCE5C\uAD6C\uAC00... \uC774\uB7F0 \uC810 \uB54C\uBB38\uC5D0
      \uC800\uB791 \uAC19\uC774 \uC788\uC73C\uBA74 \uC9C0\uCE5C\uB2E4\uACE0 \uB9D0\uD55C
      \uC801\uC774 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122161
    m_Localized: "\uC544\uB9C8 \uADF8 \uCE5C\uAD6C \uB9D0\uC774 \uB9DE\uC558\uC744
      \uAC70\uC608\uC694. ///\uADF8 \uCE5C\uAD6C\uB294 \uB300\uCCB4\uB85C \uB298
      \uC633\uC558\uAC70\uB4E0\uC694///."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122162
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122163
    m_Localized: "\uC788\uC796\uC544\uC694, \uC544\uB2C8\uC5D0\uC694. \uC65C \uD56D\uC0C1
      \uC800\uB9CC \uB2E4\uB978 \uC0AC\uB78C\uC744 \uC9C0\uCE58\uAC8C \uD558\uB294
      \uC0AC\uB78C\uC774 \uB418\uC5B4\uC57C \uD558\uC8E0?\n\n\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122164
    m_Localized: "\uC5B4\uB5BB\uAC8C...\n...\uC544\uB2C8\uC5D0\uC694, \uBCC4\uAC83\uB3C4
      \uC544\uB2CC \uBC14\uBCF4 \uAC19\uC740 \uC9C8\uBB38\uC774\uB124\uC694.\n..."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122165
    m_Localized: "\uC800\uD76C \"\uBD80\uBAA8\uB2D8\"\uC740 \uC9D1\uC5D0 \uAC70\uC758
      \uC548 \uACC4\uC138\uC694. \uC815\uB9D0 \uD55C \uBC88\uB3C4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122166
    m_Localized: "\uADF8\uB9AC\uACE0 \uC9D1\uC5D0 \uACC4\uC2E4 \uB54C\uBA74 \"\uC624\uB298
      \uC544\uBB34\uAC83\uB3C4 \uC548 \uD588\uC73C\uBA74\uC11C \uC65C \uADF8\uB807\uAC8C
      \uD53C\uACE4\uD574 \uBCF4\uC5EC?\"\uB77C\uACE0 \uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122167
    m_Localized: "\uC81C\uAC00 \uB450 \uBD84 \uB300\uC2E0 \uB3D9\uC0DD\uC744 \uD0A4\uC6E0\uC73C\uB2C8\uAE4C
      \uD53C\uACE4\uD55C \uAC70\uC796\uC544\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122168
    m_Localized: "\uADF8\uB7F0\uB370\uB3C4 \uC81C \uAE30\uBD84\uC740 \uC870\uAE08\uB3C4
      \uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uC73C\uC138\uC694. \uC800\uB294 \uB450 \uBD84\uC5D0\uAC8C
      ///\uC544\uBB34\uB9AC \uD574\uB3C4 \uBD80\uC871\uD55C \uC0AC\uB78C///\uC774\uB2C8\uAE4C\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122169
    m_Localized: "\uC544, \uC815\uB9D0..."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122170
    m_Localized: "...\uC8C4\uC1A1\uD574\uC694. \uD3C9\uC18C\uC5D0\uB294 \uD0DD\uC2DC\uC5D0\uC11C
      \uC18C\uB9AC \uC9C0\uB974\uC9C0 \uC54A\uB294\uB370.\n\uC9C0\uAE08 \uBA38\uB9BF\uC18D\uC774
      \uB108\uBB34 \uBCF5\uC7A1\uD574\uC11C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122171
    m_Localized: "...\uC81C\uAC00 \uC544\uAE4C \uB9D0\uD55C \uADF8 \uCE5C\uAD6C\uB791
      \uC624\uB298 \uD5E4\uC5B4\uC84C\uC5B4\uC694. \uADF8\uB9AC\uACE0... \uBAA8\uB974\uACA0\uC5B4\uC694.
      \uC774\uC81C \uADF8 \uC0AC\uB78C \uC5C6\uC774\uB294 ///\uC544\uBB34\uAC83\uB3C4
      \uB9D0\uC774 \uC548 \uB418\uB294/// \uAC83 \uAC19\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122172
    m_Localized: '...

'
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122173
    m_Localized: "\uADF8\uB0E5, \uC774\uC81C \uC5B4\uB5BB\uAC8C \uD574\uC57C \uD560\uC9C0
      \uBAA8\uB974\uACA0\uC5B4\uC694.\n\uC81C\uAC00 \uC544\uAE4C \uB9D0\uD55C \uADF8
      \uCE5C\uAD6C\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122174
    m_Localized: "\uC624\uB298 \uD5E4\uC5B4\uC84C\uC5B4\uC694.\n\uADF8\uB7F0\uB370
      \uC81C\uAC00 \uC9C0\uAE08 \uC5B4\uB5A4 \uAE30\uBD84\uC774\uC5B4\uC57C \uD558\uB294\uC9C0\uB3C4
      \uBAA8\uB974\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122175
    m_Localized: "\uC774\uB7F0 \uC77C\uC774 \uC0DD\uAE38 \uC904 \uBBF8\uB9AC \uC54C\uC558\uB2E4\uBA74,
      \uC801\uC5B4\uB3C4 \uB9C8\uC74C\uC758 \uC900\uBE44\uB77C\uB3C4 \uB354 \uD560
      \uC218 \uC788\uC5C8\uC744 \uD150\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122176
    m_Localized: "\uADF8\uB7F0\uB370 \uBAA8\uB4E0 \uAC8C \uB108\uBB34 \uAC11\uC791\uC2A4\uB7EC\uC6E0\uC5B4\uC694...
      \uBA70\uCE60 \uC804\uAE4C\uC9C0\uB9CC \uD574\uB3C4 \uAC19\uC774 \uC601\uD654
      \uBCF4\uB7EC \uAC00\uB824\uACE0 \uD588\uB294\uB370, \uC774\uC81C \uADF8 \uC0AC\uB78C\uACFC
      \uC598\uAE30\uB77C\uB3C4 \uD560 \uC218 \uC788\uC744\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122177
    m_Localized: "\uB9CC\uC57D \uC815\uB9D0 \uADF8\uB807\uAC8C \uB41C\uB2E4\uBA74...\n...///\uB450\uACE0
      \uBCF4\uBA74 \uC54C\uACA0\uC8E0///.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122178
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122179
    m_Localized: "\uC138\uC0C1\uC5D0... \uC81C\uAC00 \uB108\uBB34 \uB9CE\uC774 \uB9D0\uD55C
      \uAC74 \uC544\uB2C8\uACA0\uC8E0?\n\uBC18\uC751\uC744 \uBCF4\uB2C8 \uC81C \uC598\uAE30\uB97C
      \uB4E4\uC5B4 \uC8FC\uB294 \uAC8C \uC2EB\uC9C0\uB294 \uC54A\uC73C\uC2E0\uAC00
      \uBD10\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122180
    m_Localized: "\uADF8\uB798\uB3C4 \uC774\uB807\uAC8C \uD798\uB4E0 \uC598\uAE30\uB97C
      \uD55C\uAEBC\uBC88\uC5D0 \uD138\uC5B4\uB193\uC544\uC11C \uC8C4\uC1A1\uD574\uC694.\n\uBAA8\uB974\uB294
      \uC0AC\uB78C\uC5D0\uAC8C \uC774\uB807\uAC8C\uAE4C\uC9C0 \uB9D0\uD558\uBA74
      \uC548 \uB418\uB294\uB370..."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122181
    m_Localized: "\uADF8\uB798\uB3C4 \uC81C \"\uCE5C\uAD6C\uB4E4\" \uC911 \uBA87\uBA87\uBCF4\uB2E4
      \uAE30\uC0AC\uB2D8\uC774 \uC800\uC5D0 \uB300\uD574 \uB354 \uB9CE\uC774 \uC544\uC2DC\uB294
      \uAC83 \uAC19\uB124\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122182
    m_Localized: "\uC73C...\n\uBB50, \uC774\uBBF8 \uD55C \uB9D0\uC740 \uC5B4\uCA54
      \uC218 \uC5C6\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122183
    m_Localized: "\uC660\uC9C0 \uAE30\uC0AC\uB2D8\uAED8\uB294 \uC774\uB7F0 \uC598\uAE30\uB97C
      \uD574\uB3C4 \uAD1C\uCC2E\uC744 \uAC83 \uAC19\uC544\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122184
    m_Localized: "\uC5B4, \uBC8C\uC368 \uC81C \uBAA9\uC801\uC9C0\uC778\uAC00\uC694?\n\uD0DC\uC6CC
      \uC8FC\uC154\uC11C \uAC10\uC0AC\uD574\uC694. \uADF8\uB9AC\uACE0 \uBD80\uD0C1
      \uD558\uB098\uB9CC \uB4DC\uB824\uB3C4 \uB420\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122185
    m_Localized: "\uC81C\uAC00 \uD55C \uC774\uC57C\uAE30\uB294 \uC6B0\uB9AC \uB458\uB9CC\uC758
      \uBE44\uBC00\uB85C \uD574 \uC8FC\uC2E4 \uC218 \uC788\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122186
    m_Localized: "\uBD80\uD0C1\uC774\uC5D0\uC694. \uC81C\uAC00 \uD55C \uC774\uC57C\uAE30\uB294
      \uBE44\uBC00\uB85C \uD574 \uC8FC\uC138\uC694. \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC774
      \uC774 \uC77C\uC744 \uC544\uB294 \uAC74 \uBD88\uD3B8\uD574\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122187
    m_Localized: "...\uD0DC\uC6CC \uC8FC\uC154\uC11C \uAC10\uC0AC\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122188
    m_Localized: "\uD55C \uBC88\uCBE4\uC740 \uADF8\uB0E5 \uC81C\uAC00 \uC6D0\uD558\uB294
      \uAC78 \uB9D0\uD588\uB354\uB77C\uBA74...\n\uC544\uB2C8\uC5D0\uC694. \uADF8\uAC74...
      \uC0C1\uD669\uC744 \uB354 \uB098\uC058\uAC8C \uB9CC\uB4E4 \uBFD0\uC774\uACA0\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122189
    m_Localized: "\uC5B4, \uC5EC\uAE30\uAC00 \uC81C\uAC00 \uB0B4\uB9B4 \uACF3\uC778\uAC00\uC694?\n\uC800\uAE30,
      \uC0AC\uC2E4\uC740... \uC5B4... \uC544\uB2C8\uC5D0\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122190
    m_Localized: "\uACE0\uB9C8\uC6CC\uC694. \uB9AC\uBDF0\uB294 \uB0A8\uAE38\uAC8C\uC694,
      \uC544\uB9C8\uB3C4\uC694. \uC6D0\uB798 \uADF8\uB7F0 \uAC70\uC8E0?"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122191
    m_Localized: "\uC0DD\uAC01\uD574 \uBCF4\uB2C8, \uC81C\uAC00 \uB9D0\uD55C \uAC83\uB9CC\uD07C
      \uB098\uC05C \uC0C1\uD669\uC740 \uC544\uB2D0\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122192
    m_Localized: "\uB3C4\uC11C\uAD00 \uCC45\uC7A5\uC5D0\uC11C \uC544\uBB34 \uCC45\uC774\uB098
      \uD55C \uAD8C \uBF51\uB294 \uAC83\uACFC \uBE44\uC2B7\uD558\uC9C0 \uC54A\uB098\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122193
    m_Localized: "\uCC45\uC744 \uCC3E\uC544\uBCF4\uC9C0\uB3C4 \uC54A\uACE0, \uB4A4\uD45C\uC9C0\uB3C4
      \uC77D\uC9C0 \uC54A\uC8E0. \uADF8\uB0E5 \uD3BC\uCE58\uAE30\uB9CC \uD558\uBA74
      \uADF8 \uC548\uC5D0 ///\uB204\uAD70\uAC00\uC758 \uC778\uC0DD \uC804\uCCB4///\uAC00
      \uB2F4\uACA8 \uC788\uB294 \uAC70\uC608\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122194
    m_Localized: "\uCCAB \uD398\uC774\uC9C0\uC5D0\uB294 \uC220 \uCDE8\uD55C \uC9C4\uC0C1\uC774
      \uB098\uC62C \uC218\uB3C4 \uC788\uACE0, \uB9C8\uD754 \uBC88\uC9F8 \uD398\uC774\uC9C0\uC5D0\uB294
      \uC544\uB984\uB2E4\uC6B4 \uBB34\uC5B8\uAC00\uAC00 \uC788\uC744 \uC218\uB3C4
      \uC788\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122195
    m_Localized: "\uC800\uB294 \uC544\uB9C8 ///\uC544\uBB34\uB3C4 \uB05D\uAE4C\uC9C0
      \uC77D\uC9C0 \uC54A\uB294 \uCC45/// \uC911 \uD558\uB098\uC77C \uAC70\uC608\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122196
    m_Localized: "\uD558\uD558. \uC8C4\uC1A1\uD574\uC694. 10\uC810 \uB9CC\uC810\uC5D0
      3\uC810\uC9DC\uB9AC \uB18D\uB2F4\uC774\uC5C8\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122197
    m_Localized: '...

'
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122198
    m_Localized: "\uC0C8 \uCC45\uC744 \uC0AC\uC57C\uACA0\uC5B4\uC694.\n\uC544\uB2C8\uBA74
      \uB298 \uADF8\uB807\uB4EF \uBA3C\uC9C0\uB9CC \uC313\uC774\uAC8C \uB450\uACA0\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122199
    m_Localized: "\uC194\uC9C1\uD788 \uB9D0\uD558\uBA74, \uB204\uAD70\uAC00\uC5D0\uAC8C
      \uC77D\uD788\uB294 \uAC8C \uB450\uB824\uC6B4 \uAC83 \uAC19\uC544\uC694.\n\uB2E4\uB978
      \uC0AC\uB78C\uB4E4\uC5D0 \uB300\uD574 \uBC14\uBCF4 \uAC19\uC740 \uC0DD\uAC01\uC744
      \uD558\uB294 \uC0AC\uB78C\uC774 \uC800\uBFD0\uB9CC\uC740 \uC544\uB2C8\uB77C\uB294
      \uAC78 \uC54C\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122200
    m_Localized: "\uD558\uC9C0\uB9CC \uB204\uAD70\uAC00\uAC00 \uADF8\uB7F0 \uC0DD\uAC01\uB4E4\uC744
      \uC77D\uB294\uB2E4\uACE0 \uC0C1\uC0C1\uD558\uB294 \uAC83\uB9CC\uC73C\uB85C\uB3C4
      \uBC8C\uC368 \uBD88\uD3B8\uD574\uC838\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122201
    m_Localized: "\uC81C \uC5EC\uB3D9\uC0DD\uC740 \uC774\uB7F0 \uAC78 \uBCC4\uB85C
      \uC2E0\uACBD \uC4F0\uC9C0 \uC54A\uC744 \uAC70\uC608\uC694.\n\uB204\uAD6C\uC5D0\uAC8C\uB098
      \uB9D0\uC744 \uAC78\uAC70\uB4E0\uC694. \uBC84\uC2A4 \uAE30\uC0AC\uB2D8, \uACC4\uC0B0\uC6D0,
      \uC2EC\uC9C0\uC5B4 \uC774\uC6C3\uC9D1 \uAC15\uC544\uC9C0\uD55C\uD14C\uB3C4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122202
    m_Localized: "\uAC54\uB294 \uB9E4 \uC21C\uAC04 \uC0C8\uB85C\uC6B4 \uCE5C\uAD6C\uB97C
      \uC0AC\uADC0\uB294 \uAC83 \uAC19\uC544\uC694.\n\uADF8\uB7F0 \uC131\uACA9\uC740
      \uB300\uCCB4 \uC5B4\uB514\uC11C \uC0DD\uAE34 \uAC74\uC9C0 \uBAA8\uB974\uACA0\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122203
    m_Localized: "\uC81C\uAC00 \uAC54\uD55C\uD14C \uAE00 \uC77D\uB294 \uBC95\uC744
      \uAC00\uB974\uCCD0 \uC92C\uB294\uB370\uB3C4 \uB9D0\uC774\uC5D0\uC694. \uC800\uB791
      \uAC54\uB294 ///\uC644\uC804\uD788 \uC815\uBC18\uB300///\uC778 \uAC83 \uAC19\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122204
    m_Localized: "\uC6C3\uAE30\uC8E0. \uC81C \uCC45\uC744 \uC804\uBD80 \uAC54\uD55C\uD14C
      \uC92C\uC73C\uBA74\uC11C, \uC815\uC791 \uC81C \uBAAB\uC73C\uB85C\uB294 \uD55C
      \uAD8C\uB3C4 \uB0A8\uAE30\uC9C0 \uC54A\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122205
    m_Localized: "...\uC544\uBB34 \uCC45\uC774\uB098 \uACE8\uB77C \uC77D\uB294\uB2E4\uB294
      \uBE44\uC720\uB97C \uB9D0\uD558\uB294 \uAC74 \uC544\uB2C8\uC5D0\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122206
    m_Localized: "...\uC801\uC5B4\uB3C4 \uC81C \uC0DD\uAC01\uC5D4 \uC544\uB2CC \uAC83
      \uAC19\uC544\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122207
    m_Localized: "\uC774\uB807\uAC8C \uC804\uBD80 \uC785 \uBC16\uC73C\uB85C \uAEBC\uB0B4
      \uB193\uACE0 \uBCF4\uB2C8 \uC81C\uAC00 \uAC54\uB97C \uC9C8\uD22C\uD558\uB294
      \uAC83\uCC98\uB7FC \uB4E4\uB9AC\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122208
    m_Localized: "\uC5B4\uCA4C\uBA74 \uC815\uB9D0 \uC870\uAE08\uC740 \uADF8\uB7F4\uC9C0\uB3C4
      \uBAA8\uB974\uC8E0. ///\uD558\uD558///. \uAC54\uD55C\uD150 \uB9D0\uD558\uC9C0
      \uB9C8\uC138\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122209
    m_Localized: ...
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122210
    m_Localized: "\uADF8\uB798\uB3C4 \uC800\uB97C \uB05D\uAE4C\uC9C0 \uC77D\uC5B4
      \uC900 \uC0AC\uB78C\uC774 \uD55C \uBA85 \uC788\uAE34 \uD588\uC5B4\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122211
    m_Localized: "\uADF8 \uC0AC\uB78C\uC740 \uACB0\uB9D0\uC774 \uB9C8\uC74C\uC5D0
      \uB4E4\uC9C0 \uC54A\uC558\uACA0\uC9C0\uB9CC... \uC801\uC5B4\uB3C4 ///\uCC98\uC74C\uC740
      \uC990\uAC81\uAC8C \uC77D\uC5C8\uAE30\uB97C/// \uBC14\uB77C\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122212
    m_Localized: "\uC81C\uAC00 \uB9D0\uD558\uB294 \uC0AC\uB78C\uC740 \uC81C \uB0A8\uC790
      \uCE5C... \uC804 \uB0A8\uC790\uCE5C\uAD6C\uC608\uC694. \uC820\uC7A5, \uC774\uB807\uAC8C
      \uB9D0\uD558\uB2C8\uAE4C \uC815\uB9D0 \uAE30\uBD84\uC774 \uC774\uC0C1\uD558\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122213
    m_Localized: "\uADF8\uB7EC\uB2C8\uAE4C, \uADF8 \uC0AC\uB78C\uC740 \uC800\uB97C
      \uC774\uD574\uD574 \uC92C\uAC70\uB4E0\uC694. \uBB34\uC2A8 \uB9D0\uC778\uC9C0
      \uC544\uC2DC\uC8E0? \uC800\uB97C \uC5B4\uB5A4 \uC0AC\uB78C\uC774\uB77C\uACE0
      \uB2E8\uC815 \uC9D3\uC9C0\uB3C4 \uC54A\uC558\uACE0, \uC5B5\uC9C0\uB85C \uBCC0\uD558\uB77C\uACE0
      \uBAB0\uC544\uBD99\uC774\uC9C0\uB3C4 \uC54A\uC558\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122214
    m_Localized: "\uADF8 \uC810\uC740 \uADF8 \uC0AC\uB78C\uC5D0\uAC8C ///\uC815\uB9D0
      \uACE0\uB9D9\uAC8C \uC0DD\uAC01\uD574\uC694///.\n\uC815\uB9D0 \uB9CE\uC774\uC694..."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122215
    m_Localized: "\uBA3C\uC800 \uD5E4\uC5B4\uC9C0\uC790\uACE0 \uD55C \uAC74 \uADF8
      \uC0AC\uB78C\uC778\uB370\uB3C4, \uC544\uC9C1 \uADF8 \uC0AC\uB78C\uC744 \uC6D0\uB9DD\uD560
      \uC218\uAC00 \uC5C6\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122216
    m_Localized: '...

'
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122217
    m_Localized: "\uCC28\uC5D0 \uB0C4\uC0C8\uB098\uB294 \uC0AC\uB78C\uC774 \uD0C0\uB294
      \uAC8C \uC2EB\uB2E4\uB294 \uC598\uAE30\uB97C \uD558\uB2E4\uAC00 \uC5B4\uCA4C\uB2E4
      \uC774\uB7F0 \uC774\uC57C\uAE30\uAE4C\uC9C0 \uD558\uAC8C \uB410\uB294\uC9C0,
      \uCC38 \uC6C3\uAE30\uB124\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122218
    m_Localized: "\uBB50, \uC544\uBB34\uD2BC\uC694.\n\uC81C \uBAA9\uC801\uC9C0\uC5D0
      \uAC70\uC758 \uB2E4 \uC628 \uAC83 \uAC19\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122219
    m_Localized: "\uD0DC\uC6CC \uC8FC\uC154\uC11C \uAC10\uC0AC\uD574\uC694. \uC548\uB155\uD788
      \uACC4\uC138\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122220
    m_Localized: "\uC81C \uC598\uAE30\uB97C \uB4E4\uC5B4 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD574\uC694...
      \uC774\uB807\uAC8C \uC27D\uAC8C \uC18D\uB9C8\uC74C\uC744 \uD138\uC5B4\uB193\uC744
      \uC218 \uC788\uC744 \uC904\uC740 \uC800\uB3C4 \uBAB0\uB790\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122221
    m_Localized: "\uD0DD\uC2DC\uB97C \uD0C0\uACE0 \uAC00\uB2E4\uAC00 \uC0C1\uB2F4
      \uC2DC\uAC04\uC774 \uB420 \uC904\uC740 \uBAB0\uB790\uB294\uB370, \uC5B4\uCA4C\uB2E4
      \uBCF4\uB2C8 \uADF8\uB807\uAC8C \uB410\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122222
    m_Localized: "\uC800\uB3C4 \uAE30\uC0AC\uB2D8 \uC774\uC57C\uAE30\uB97C \uC870\uAE08\uC774\uB77C\uB3C4
      \uB4E4\uC5B4 \uBCF4\uACE0 \uC2F6\uC5B4\uC694. \uD558\uD558.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122223
    m_Localized: "\uADF8\uB798\uB3C4 \uAD1C\uCC2E\uC544\uC694. \uAE30\uC0AC\uB2D8\uC774
      \uACC4\uC18D \uC5EC\uAE30\uC11C \uC77C\uD558\uACE0 \uACC4\uC2E0\uB2E4\uBA74
      \uB2E4\uC74C\uC5D0 \uAE30\uD68C\uAC00 \uC788\uACA0\uC8E0."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122224
    m_Localized: "\uC5B4\uCA0C\uB4E0, \uC81C \uBAA9\uC801\uC9C0\uC5D0 \uAC70\uC758
      \uB2E4 \uC628 \uAC83 \uAC19\uC544\uC694.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122225
    m_Localized: "\uB2E4\uC2DC \uD55C\uBC88 \uAC10\uC0AC\uD574\uC694. \uB0A8\uC740
      \uBC24\uB3C4 \uD3B8\uC548\uD558\uAC8C \uBCF4\uB0B4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122226
    m_Localized: "\uBB3C\uAC74\uACFC \uC0C1\uD638\uC791\uC6A9\uD558\uB824\uBA74 \uD0A4\uBCF4\uB4DC\uC758
      \"E\" \uD0A4\uB098 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC(LMB)\uC744
      \uB204\uB974\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 57487596122227
    m_Localized: "\uBB3C\uAC74\uACFC\uC758 \uC0C1\uD638\uC791\uC6A9\uC744 \uB05D\uB0B4\uB824\uBA74
      \uD0A4\uBCF4\uB4DC\uC758 \"Q\" \uD0A4\uB098 \uB9C8\uC6B0\uC2A4 \uC624\uB978\uCABD
      \uBC84\uD2BC(RMB)\uC744 \uB204\uB974\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 757112707674112
    m_Localized: "\uC0C9\uACFC \uC74C\uC545\uC774 \uC5B4\uB5BB\uAC8C \uC5B4\uC6B0\uB7EC\uC9C0\uB294\uC9C0
      \uD655\uC778\uD558\uB824\uBA74 \uC81C\uAC00 \uB0A8\uACA8 \uB454 \uBA54\uBAA8\uB97C
      \uC5F4\uC5B4 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 757112787365888
    m_Localized: "\uBA54\uBAA8\uB294 \uC624\uB978\uCABD \uC88C\uC11D \uC704\uC5D0
      \uC788\uC5B4\uC694.\r\n\uC5B4\uB5BB\uAC8C \uD574\uC57C \uD560\uC9C0 \uBAA8\uB974\uACA0\uC744
      \uB54C\uB294 \uC5B8\uC81C\uB4E0 \uC5F4\uC5B4 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3353247208521728
    m_Localized: "\uC88B\uC740 \uB9AC\uBDF0 \uB0A8\uAE38\uAC8C\uC694. \uADF8\uB7F0
      \uAC70 \uC2E0\uACBD \uC4F0\uC2DC\uC796\uC544\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 3353247309185024
    m_Localized: "\uC65C ///\uB9E4\uB825\uC801///\uC774\uB77C\uACE0 \uD558\uB294\uC9C0\uB294
      \uC54C \uAC83 \uAC19\uC544\uC694... \uC544\uB2C8, \uC5ED\uC2DC \uC544\uB2CC
      \uAC83 \uAC19\uB124\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3353247309185025
    m_Localized: "\uD30C\uC7A5\uACFC \uB192\uC774\uB294 \uC11C\uB85C \uB2E4\uB978
      \uC815\uB3C4\uB85C \uC65C\uACE1\uB3FC\uC694. \uC644\uBCBD\uD55C \uB2F5\uC744
      \uC5BB\uC73C\uB824\uBA74 \uC65C\uACE1\uC744 \uCD5C\uC18C\uD654\uD574\uC57C
      \uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3353247309185026
    m_Localized: "\uD30C\uB3D9\uC774 \uB04A\uACA8 \uC788\uB2E4\uBA74, \uC0AC\uC6A9\uD55C
      \uC870\uBA85\uACFC \uC74C\uC545\uC740 \uAC01\uAC01 \uB9DE\uC9C0\uB9CC \uC11C\uB85C
      \uC5B4\uC6B8\uB9AC\uB294 \uC870\uD569\uC740 \uC544\uB2C8\uB77C\uB294 \uB73B\uC774\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 3353247309185027
    m_Localized: "\uC190\uB2D8\uC5D0\uAC8C \uAC00\uC7A5 \uC798 \uB9DE\uB294 \uC870\uD569\uC744
      \uCC3E\uC73C\uBA74 \uC644\uBCBD\uD55C \uB2F5\uC744 \uC5BB\uC744 \uC218 \uC788\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
